# AI API keys are stored in the browser's localStorage.
# Binance Futures public API does not require authentication.

# Finnhub API key (free: https://finnhub.io/register)
# Used for economic calendar data (FOMC, CPI, NFP, etc.)
# Optional: system works without it, but economic event warnings will be disabled.
FINNHUB_API_KEY=

# NewsData.io API key (free: https://newsdata.io)
# Used for world news display (geopolitics, regulation, crypto news)
# Optional: system works without it, but news section will be hidden.
NEWSDATA_API_KEY=
